@page "/"

@using HouseKeeper.Contracts.Authentication
@using HouseKeeper.Contracts.Households
@using HouseKeeper.Web.Components
@using HouseKeeper.Web.Services

@inject IConfiguration Configuration
@inject IApiAuthentication Authentication
@inject HouseKeeperApiClient ApiClient
@inject NavigationManager Navigation
@inject IServiceProvider Services

<PageTitle>HouseKeeper</PageTitle>

<div class="container py-4" style="max-width: 48rem;">
    <header class="mb-4">
        <p class="text-uppercase text-secondary fw-semibold mb-1">HouseKeeper</p>
        <h1>Know what your home needs today.</h1>
        <p class="lead text-secondary">
            Sign in securely, then HouseKeeper uses your household membership to decide
            what you can access.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert" data-testid="error-message">
            @errorMessage
        </div>
    }

    @if (currentUser is null)
    {
        <section class="card shadow-sm" aria-labelledby="sign-in-heading">
            <div class="card-body p-4">
                <h2 id="sign-in-heading" class="h4">
                    @(isDevelopmentAuthentication ? "Development sign-in" : "Sign in to HouseKeeper")
                </h2>
                <p class="text-secondary">
                    @(isDevelopmentAuthentication
                        ? "Local development uses a temporary browser identity. It is disabled outside the Development environment."
                        : "Cognito securely handles your password, email verification, and account recovery. HouseKeeper never receives your password.")
                </p>

                @if (isDevelopmentAuthentication)
                {
                    <label class="form-label" for="display-name">Display name</label>
                    <input id="display-name"
                           class="form-control"
                           data-testid="display-name"
                           maxlength="120"
                           @bind="displayName"
                           @bind:event="oninput" />
                }

                <button class="btn btn-primary mt-3"
                        data-testid="sign-in"
                        disabled="@isBusy"
                        @onclick="SignInAsync">
                    @(isBusy ? "Opening secure sign-in…" : "Sign in")
                </button>

                @if (!isDevelopmentAuthentication)
                {
                    <p class="small text-secondary mt-3 mb-0">
                        New here? The secure sign-in page lets you create and verify an account.
                    </p>
                }
            </div>
        </section>
    }
    else
    {
        <section class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
            <div>
                <span class="text-secondary">Signed in as</span>
                <strong data-testid="current-user">@currentUser.DisplayName</strong>
            </div>
            <button class="btn btn-outline-secondary btn-sm"
                    disabled="@isBusy"
                    @onclick="SignOutAsync">
                Sign out
            </button>
        </section>

        <section class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h4">Create your household</h2>
                <p class="text-secondary">
                    Household access is owned by HouseKeeper membership, not by Cognito roles.
                </p>

                <label class="form-label" for="household-name">Household name</label>
                <input id="household-name"
                       class="form-control"
                       data-testid="household-name"
                       maxlength="120"
                       @bind="householdName"
                       @bind:event="oninput" />

                <button class="btn btn-primary mt-3"
                        data-testid="create-household"
                        disabled="@isBusy"
                        @onclick="CreateHouseholdAsync">
                    @(isBusy ? "Saving…" : "Create household")
                </button>
            </div>
        </section>

        <section aria-labelledby="households-heading">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h2 id="households-heading" class="h4 mb-0">Your households</h2>
                <button class="btn btn-link btn-sm"
                        disabled="@isBusy"
                        @onclick="LoadHouseholdsAsync">
                    Refresh
                </button>
            </div>

            <HouseholdList Items="@households" />
        </section>
    }
</div>

@code {
    private CurrentUserResponse? currentUser;
    private IReadOnlyList<HouseholdSummary> households = [];
    private string displayName = string.Empty;
    private string householdName = string.Empty;
    private string? errorMessage;
    private bool isBusy;
    private bool isDevelopmentAuthentication;

    protected override async Task OnInitializedAsync()
    {
        isDevelopmentAuthentication = string.Equals(
            Configuration["Authentication:Mode"],
            "Development",
            StringComparison.OrdinalIgnoreCase);

        if (await Authentication.IsAuthenticatedAsync())
        {
            await ExecuteAsync(LoadHouseholdsCoreAsync);
        }
    }

    private Task SignInAsync()
    {
        if (!isDevelopmentAuthentication)
        {
            Navigation.NavigateTo("authentication/login", forceLoad: true);
            return Task.CompletedTask;
        }

        return ExecuteAsync(async () =>
        {
            DevelopmentSession session = GetDevelopmentSession();
            _ = await session.SignInAsync(displayName);
            await LoadHouseholdsCoreAsync();
            displayName = string.Empty;
        });
    }

    private Task SignOutAsync()
    {
        if (!isDevelopmentAuthentication)
        {
            Navigation.NavigateTo("authentication/logout", forceLoad: true);
            return Task.CompletedTask;
        }

        return ExecuteAsync(async () =>
        {
            await Authentication.SignOutAsync();
            currentUser = null;
            households = [];
            householdName = string.Empty;
        });
    }

    private Task CreateHouseholdAsync() => ExecuteAsync(async () =>
    {
        HouseholdSummary created = await ApiClient.CreateHouseholdAsync(
            Authentication,
            householdName);
        households = [.. households, created];
        householdName = string.Empty;
    });

    private Task LoadHouseholdsAsync() => ExecuteAsync(LoadHouseholdsCoreAsync);

    private async Task LoadHouseholdsCoreAsync()
    {
        currentUser = await ApiClient.GetCurrentUserAsync(Authentication);
        households = await ApiClient.ListHouseholdsAsync(Authentication);
    }

    private DevelopmentSession GetDevelopmentSession() =>
        Services.GetRequiredService<DevelopmentSession>();

    private async Task ExecuteAsync(Func<Task> action)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            errorMessage = isDevelopmentAuthentication
                ? exception.Message
                : "We could not complete that secure action. Please try again.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
